apiVersion: v1
kind: Secret
metadata:
  name: otel-secrets
  namespace: resume-agent
type: Opaque
stringData:
  # OpenObserve root user credentials
  ZO_ROOT_USER_EMAIL: "admin@example.com"
  ZO_ROOT_USER_PASSWORD: "changeme123"
  # Base64-encoded "email:password" for the Collector's Authorization header
  # Generate with: echo -n "admin@example.com:changeme123" | base64
  OPENOBSERVE_AUTH: "Basic YWRtaW5AZXhhbXBsZS5jb206Y2hhbmdlbWUxMjM="
