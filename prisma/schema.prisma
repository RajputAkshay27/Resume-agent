generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String       @id @default(cuid())
  name            String?
  email           String?      @unique
  passwordHash    String?
  masterProfile   String?      // JSON string — the user's comprehensive profile
  templateKey     String?      // S3 key to the user's Jinja2 .tex template
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  ChatThreads     ChatThread[]
}

model ChatThread {
  id              String   @id @default(uuid())
  title           String
  tailoredProfile String?  // JSON string — Pydantic-validated tailored resume data
  templateKey     String?  // S3 key — copy of the user's template for this thread
  sectionPrefs    String?  // JSON string — SectionPreferences for this generation
  pdfKey          String?
  pdfHash         String?
  jobDescription  String?
  jobUrl          String?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt       DateTime @default(now()) @updatedAt
  createdAt       DateTime @default(now())
}
